{
  "id": "hanime1",
  "name": "Hanime1",
  "version": "2.0.0",
  "apiVersion": 4,
  "entry": "plugin.js",
  "description": "Videos de hanime1.me: inicio con filas (incluye Sin censura), búsqueda paginada completa y reproducción con selector de calidad.",
  "author": "Hotaru Yume",
  "creator": "hotaruyume",
  "hosts": [
    "hanime1.me",
    "*.hanime1.me",
    "hanime1.com",
    "*.hanime1.com",
    "hanimeone.me",
    "*.hanimeone.me",
    "javchu.com",
    "*.javchu.com",
    "vdownload.hembed.com",
    "*.hembed.com",
    "rsc.cdn77.org",
    "*.rsc.cdn77.org"
  ],
  "streamHosts": "any",
  "capabilities": ["search", "home", "browse", "resolve"],
  "settings": [
    {
      "key": "quality",
      "label": "Calidad del video",
      "type": "select",
      "default": "best",
      "options": [
        { "value": "best", "label": "La mejor disponible" },
        { "value": "auto", "label": "Automático (según conexión)" },
        { "value": "1080", "label": "1080p" },
        { "value": "720", "label": "720p" },
        { "value": "480", "label": "480p" },
        { "value": "360", "label": "360p" },
        { "value": "worst", "label": "La más baja (ahorra datos)" }
      ],
      "hint": "Se aplica al reproducir; Auto deja elegir al reproductor"
    }
  ],
  "categories": ["adult"],
  "color": "#FF5C8D",
  "icon": "icon.png"
}